rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enforce tenant/user-level data isolation on users subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /vehicleServices/{serviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Secure application requests collection
    match /application_requests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow update, delete: if request.auth != null;
    }

    // Permit global fallback for system modules not yet secured
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
